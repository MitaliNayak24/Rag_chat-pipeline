# ── Copy to .env and fill in values ──────────────────────────────────

# Required
OPENAI_API_KEY=sk-...

# ChromaDB persistence path
# On Render with persistent disk: /data/chroma
# Local dev: ./chroma_data
CHROMA_PERSIST_PATH=./chroma_data

# Optional — enables Cohere reranking (improves answer quality)
# Get free key at: https://cohere.com
# COHERE_API_KEY=your-cohere-key

# Server port (Render sets this automatically)
PORT=8000
